{% extends '@PrestaShop/Admin/layout.html.twig' %}
{% trans_default_domain 'Modules.Wipop.Admin' %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('../modules/wipop/views/css/admin/configuration.css') }}">
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script src="{{ asset('../modules/wipop/views/js/admin/configuration.js') }}"></script>
{% endblock %}

{% block content %}
  {{ form_start(configurationForm, {'attr': {'data-wipop-settings-form': '1'}}) }}
    <div class="row justify-content-center">
      <div class="col-xl-10">
        <div class="card" data-wipop-section="configuration">
          <h3 class="card-header">
            <i class="material-icons">settings</i> {{ 'Payment configuration with Wipop'|trans }}
          </h3>
          <div class="card-body">
            <div class="wipop-settings-form">
              {{ form_errors(configurationForm) }}
              {{ form_row(configurationForm.live_mode) }}
              {{ form_row(configurationForm.merchant_id) }}
              {{ form_row(configurationForm.secret_key) }}
              {{ form_row(configurationForm.public_secret_key) }}
              {{ form_row(configurationForm.terminal_id) }}
              {{ form_row(configurationForm.capture_mode) }}
            </div>
            <div id="wipop-verify-credentials-result" class="alert d-none mt-3" role="alert" aria-live="polite"></div>
          </div>
          <div class="card-footer">
            <div class="d-flex justify-content-end">
              <button
                type="button"
                class="btn btn-outline-secondary mr-2"
                id="wipop-verify-credentials-button"
                data-verify-url="{{ path('wipop_verify_credentials') }}"
                data-csrf-token="{{ csrf_token('wipop_verify_credentials') }}"
                data-verifying-label="{{ 'Verifying...'|trans }}"
                data-unsaved-message="{{ 'Save changes before verifying data.'|trans }}"
                data-error-message="{{ 'Could not verify Wipop data. Check the settings and try again.'|trans }}"
                {% if not canVerifyStoredSettings %}disabled{% endif %}
              >
                {{ 'Verify data'|trans }}
              </button>
              <button type="submit" class="btn btn-primary" data-wipop-save-button="configuration">
                {{ 'Save'|trans({}, 'Admin.Actions') }}
              </button>
            </div>
          </div>
        </div>

        <div class="card" data-wipop-section="gateways">
          <h3 class="card-header">
            <i class="material-icons">payment</i> {{ 'Payment methods'|trans }}
          </h3>
          <div class="card-body">
            {% set gatewayCards = {
              'CARD': {
                'icon': 'credit_card',
                'description': 'Accept card payments through Wipop.'|trans
              },
              'BIZUM': {
                'icon': 'smartphone',
                'description': 'Let customers pay with Bizum through Wipop.'|trans
              }
            } %}

            <div>
              {{ form_errors(configurationForm.enabled_gateways) }}

              <div class="wipop-gateway-grid">
                {% for gateway in configurationForm.enabled_gateways %}
                  {% set gatewayValue = gateway.vars.value %}
                  {% set gatewayCard = gatewayCards[gatewayValue]|default({
                    'icon': 'payment',
                    'description': ''
                  }) %}
                  <div class="wipop-gateway-option">
                    <input
                      type="checkbox"
                      id="{{ gateway.vars.id }}"
                      name="{{ gateway.vars.full_name }}"
                      value="{{ gateway.vars.value }}"
                      class="wipop-gateway-input"
                      {% if gateway.vars.checked %}checked="checked"{% endif %}
                      {% if gateway.vars.disabled %}disabled="disabled"{% endif %}
                    >
                    {% do gateway.setRendered %}
                    <label class="wipop-gateway-card" for="{{ gateway.vars.id }}">
                      <span class="wipop-gateway-icon">
                        <i class="material-icons">{{ gatewayCard.icon }}</i>
                      </span>
                      <span class="wipop-gateway-content">
                        <span class="wipop-gateway-title">{{ gateway.vars.label|trans }}</span>
                        {% if gatewayCard.description %}
                          <span class="wipop-gateway-description">{{ gatewayCard.description }}</span>
                        {% endif %}
                      </span>
                      <span class="wipop-gateway-check" aria-hidden="true"></span>
                    </label>
                  </div>
                {% endfor %}
                {% do configurationForm.enabled_gateways.setRendered %}
              </div>
            </div>
          </div>
          <div class="card-footer">
            <div class="d-flex justify-content-end">
              <button type="submit" class="btn btn-primary" data-wipop-save-button="gateways">
                {{ 'Save'|trans({}, 'Admin.Actions') }}
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  {{ form_end(configurationForm) }}

  <div class="row justify-content-center">
    <div class="col-xl-10">
      <div class="card">
        <h3 class="card-header">
          <i class="material-icons">sync_alt</i> {{ 'Webhook authentication'|trans }}
        </h3>
        <div class="card-body">
          {% set webhookRows = [
            {'label': 'Webhook URL'|trans, 'value': webhook.url},
            {'label': 'Webhook user'|trans, 'value': webhook.username},
            {'label': 'Webhook password'|trans, 'value': webhook.password},
            {'label': 'State'|trans, 'value': webhook.state_label},
            {'label': 'Verification code'|trans, 'value': webhook.verification_code},
            {'label': 'Code received at'|trans, 'value': webhook.verification_received_at},
            {'label': 'Connected at'|trans, 'value': webhook.connected_at}
          ] %}

          {% for row in webhookRows %}
            <div class="form-group row">
              <label class="form-control-label col-lg-3">{{ row.label }}</label>
              <div class="col-lg-9">
                <input type="text" class="form-control" readonly value="{{ row.value ?: '-' }}">
              </div>
            </div>
          {% endfor %}
        </div>
        <div class="card-footer">
          <form method="post" action="{{ path('wipop_webhook_regenerate') }}" class="d-flex align-items-center justify-content-end">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('wipop_webhook_regenerate') }}">
            <span class="text-muted mr-3">
              {{ 'After regenerating, update the user and password in the Wipop portal.'|trans }}
            </span>
            <button type="submit" class="btn btn-outline-secondary">
              {{ 'Regenerate credentials'|trans }}
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
{% endblock %}
