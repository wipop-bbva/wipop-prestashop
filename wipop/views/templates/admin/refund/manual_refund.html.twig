{% extends '@PrestaShop/Admin/layout.html.twig' %}
{% trans_default_domain 'Modules.Wipop.Admin' %}

{% block content %}
  {{ form_start(refundForm) }}
    <div class="row justify-content-center">
      <div class="col-xl-10">
        <div class="card">
          <h3 class="card-header">
            <i class="material-icons">undo</i> {{ 'Wipop refund'|trans }}
          </h3>
          <div class="card-body">
            <div class="form-group row">
              <label class="form-control-label col-lg-3">{{ 'Order'|trans({}, 'Admin.Global') }}</label>
              <div class="col-lg-9">
                <input type="text" class="form-control" readonly value="#{{ orderId }}">
              </div>
            </div>
            <div class="form-group row">
              <label class="form-control-label col-lg-3">{{ 'Wipop transaction'|trans }}</label>
              <div class="col-lg-9">
                <input type="text" class="form-control" readonly value="{{ wipopPayment.wipopTransactionId ?: '-' }}">
              </div>
            </div>
            <div class="form-group row">
              <label class="form-control-label col-lg-3">{{ 'Remaining amount'|trans }}</label>
              <div class="col-lg-9">
                <input type="text" class="form-control" readonly value="{{ remainingAmount }}">
              </div>
            </div>

            {% if refundData.lines|length > 0 %}
              <div class="table-responsive">
                <table class="table">
                  <thead>
                    <tr>
                      <th>{{ 'Product'|trans({}, 'Admin.Global') }}</th>
                      <th>{{ 'Reference'|trans({}, 'Admin.Global') }}</th>
                      <th>{{ 'Refundable quantity'|trans }}</th>
                      <th>{{ 'Refundable amount'|trans }}</th>
                      <th>{{ 'Quantity'|trans({}, 'Admin.Global') }}</th>
                      <th>{{ 'Amount'|trans({}, 'Admin.Global') }} ({{ refundData.taxMethod }})</th>
                    </tr>
                  </thead>
                  <tbody>
                    {% for line in refundData.lines %}
                      {% set quantityField = 'quantity_' ~ line.orderDetailId %}
                      {% set amountField = 'amount_' ~ line.orderDetailId %}
                      <tr>
                        <td>{{ line.name }}</td>
                        <td>{{ line.reference ?: '-' }}</td>
                        <td>{{ line.quantityRefundable }}</td>
                        <td>{{ line.amountRefundableFormatted }}</td>
                        <td>{{ form_widget(attribute(refundForm, quantityField)) }}</td>
                        <td>{{ form_widget(attribute(refundForm, amountField)) }}</td>
                      </tr>
                    {% endfor %}
                  </tbody>
                </table>
              </div>
            {% endif %}

            <div class="form-group row">
              <label class="form-control-label col-lg-3">
                {{ 'Refundable shipping'|trans }}
              </label>
              <div class="col-lg-9">
                <input type="text" class="form-control" readonly value="{{ refundData.shippingRefundableAmountFormatted }}">
              </div>
            </div>
            {{ form_row(refundForm.shipping_amount) }}
            {{ form_row(refundForm.restock) }}
            {{ form_rest(refundForm) }}
          </div>
          <div class="card-footer d-flex justify-content-between">
            <a class="btn btn-outline-secondary" href="{{ path('admin_orders_view', {'orderId': orderId}) }}">
              {{ 'Cancel'|trans({}, 'Admin.Actions') }}
            </a>
            <button type="submit" class="btn btn-primary">
              {{ 'Refund with Wipop'|trans }}
            </button>
          </div>
        </div>
      </div>
    </div>
  {{ form_end(refundForm, {'render_rest': false}) }}
{% endblock %}
