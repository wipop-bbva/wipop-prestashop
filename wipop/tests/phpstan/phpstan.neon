parameters:
    level: 4
    parallel:
        maximumNumberOfProcesses: 1
    paths:
        - %currentWorkingDirectory%/autoload.php
        - %currentWorkingDirectory%/controllers
        - %currentWorkingDirectory%/src
        - %currentWorkingDirectory%/upgrade
        - %currentWorkingDirectory%/wipop.php
    excludePaths:
        analyse:
            - %currentWorkingDirectory%/vendor/*
            - %currentWorkingDirectory%/var/*
    bootstrapFiles:
        - %currentWorkingDirectory%/tests/phpstan/bootstrap.php
    tmpDir: %currentWorkingDirectory%/var/phpstan
    reportUnmatchedIgnoredErrors: true
    treatPhpDocTypesAsCertain: true
    checkImplicitMixed: true
