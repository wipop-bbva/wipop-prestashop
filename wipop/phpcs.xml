<?xml version="1.0"?>
<ruleset name="Wipop PrestaShop Module">
  <description>Basic PHPCS rules for the Wipöp PrestaShop module.</description>

  <arg name="basepath" value="."/>
  <arg name="colors"/>

  <file>autoload.php</file>
  <file>src</file>
  <file>wipop.php</file>
  <file>controllers</file>
  <file>tests</file>

  <exclude-pattern>dist/*</exclude-pattern>
  <exclude-pattern>vendor/*</exclude-pattern>
  <exclude-pattern>var/*</exclude-pattern>

  <rule ref="PSR12">
    <!-- PrestaShop Addons validator rejects blank lines before the file header. -->
    <exclude name="PSR12.Files.FileHeader.SpacingAfterTagBlock"/>
    <exclude name="PSR12.Files.FileHeader.SpacingAfterDocblockBlock"/>
  </rule>

  <rule ref="PSR1.Classes.ClassDeclaration.MissingNamespace">
    <exclude-pattern>wipop.php</exclude-pattern>
    <exclude-pattern>controllers/*</exclude-pattern>
  </rule>

  <rule ref="PSR1.Files.SideEffects.FoundWithSymbols">
    <exclude-pattern>autoload.php</exclude-pattern>
    <exclude-pattern>controllers/*</exclude-pattern>
    <exclude-pattern>wipop.php</exclude-pattern>
    <exclude-pattern>src/*</exclude-pattern>
    <exclude-pattern>tests/phpstan/bootstrap.php</exclude-pattern>
    <exclude-pattern>tests/bootstrap.php</exclude-pattern>
  </rule>

  <rule ref="PSR12.Files.FileHeader.SpacingAfterDocblockBlock">
    <exclude-pattern>autoload.php</exclude-pattern>
    <exclude-pattern>controllers/*</exclude-pattern>
    <exclude-pattern>wipop.php</exclude-pattern>
  </rule>
</ruleset>
